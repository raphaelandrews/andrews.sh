{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "andrews",
	"main": "src/index.js",
	"compatibility_date": "2026-11-16",
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8080
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "andrews",
			"database_id": "24a843ad-d0d2-4357-a968-4b9da931c2bd"
		}
	],
	"routes": [
		{ "pattern": "andrews.sh/*", "zone_name": "andrews.sh" },
		{ "pattern": "www.andrews.sh/*", "zone_name": "andrews.sh" }
	]
}
